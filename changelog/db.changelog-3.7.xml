<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:pro="http://www.liquibase.org/xml/ns/pro"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
                      http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-3.9.xsd
                      http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

  <changeSet id="37" author="fabien.saujot">
    <!-- One row per send attempt (the initial send plus each retry) for every
         quote_email_notifications lifecycle, for every email type. NRF2-849
         collapsed retries into the lifecycle row and moved per-attempt history
         to app logs; NRF2-1258 reverses that trade-off so the admin frontend
         can show each retry attempt and its outcome ("enable testing in
         production"). notified_send_status is free-text like the lifecycle
         column — Notify owns the vocabulary. A single attempted_at timestamp:
         a separate created_at would duplicate it. No unique constraints —
         rejected sends carry a NULL notification_id, so several attempts per
         lifecycle can hold NULL. Lifecycle rows created before this changeset
         simply have no attempt history. -->
    <createTable tableName="quote_email_notification_attempts">
      <column name="id" type="INT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="email_notification_id" type="INT">
        <constraints nullable="false"
                     foreignKeyName="fk_qena_email_notification"
                     references="quote_email_notifications(id)"
                     deleteCascade="true"/>
      </column>
      <column name="attempt_no" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="notification_id" type="UUID"/>
      <column name="notify_send_status" type="VARCHAR(50)"/>
      <column name="attempted_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex tableName="quote_email_notification_attempts" indexName="idx_qena_email_notification">
      <column name="email_notification_id"/>
    </createIndex>
    <!-- The status poller updates attempt rows by the Notify notification id it
         fetched, so the newest accepted attempt's outcome stays live. -->
    <createIndex tableName="quote_email_notification_attempts" indexName="idx_qena_notification_id">
      <column name="notification_id"/>
    </createIndex>
    <rollback>
      <!-- Attempt history is derived observability data — safe to drop. -->
      <dropTable tableName="quote_email_notification_attempts"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
