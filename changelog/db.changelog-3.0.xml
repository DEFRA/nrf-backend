<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:pro="http://www.liquibase.org/xml/ns/pro"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
                      http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-3.9.xsd
                      http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

  <changeSet id="26" author="jon.wyatt">
    <!-- Defra ID profile columns. All nullable: user records are created when a quote is started,
         before the user has signed in. -->
    <addColumn tableName="users">
      <!-- Unique, but nullable: users created before signing in have no defra_id yet. -->
      <column name="defra_id" type="VARCHAR(255)">
        <constraints unique="true" uniqueConstraintName="uq_users_defra_id"/>
      </column>
      <column name="first_name" type="VARCHAR(255)"/>
      <column name="last_name" type="VARCHAR(255)"/>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="first_signed_in_at" type="TIMESTAMP WITH TIME ZONE"/>
    </addColumn>
    <rollback>
      <dropColumn tableName="users">
        <column name="defra_id" type="VARCHAR(255)"/>
      </dropColumn>
      <dropColumn tableName="users">
        <column name="first_name" type="VARCHAR(255)"/>
      </dropColumn>
      <dropColumn tableName="users">
        <column name="last_name" type="VARCHAR(255)"/>
      </dropColumn>
      <dropColumn tableName="users">
        <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
      </dropColumn>
      <dropColumn tableName="users">
        <column name="first_signed_in_at" type="TIMESTAMP WITH TIME ZONE"/>
      </dropColumn>
    </rollback>
  </changeSet>

  <changeSet id="27" author="jon.wyatt">
    <!-- Organisations are keyed by the Defra ID organisation id, so defra_id is a natural primary
         key (not autogenerated) and also provides the lookup index. -->
    <createTable tableName="organisations">
      <column name="defra_id" type="VARCHAR(255)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>
    <rollback>
      <dropTable tableName="organisations"/>
    </rollback>
  </changeSet>

  <changeSet id="28" author="jon.wyatt">
    <!-- User<->organisation relationships. user_id is UUID to match users(id). Rows are removed
         when the parent user or organisation row is deleted. -->
    <createTable tableName="user_organisations">
      <column name="user_id" type="UUID">
        <constraints primaryKey="true" nullable="false"
                     foreignKeyName="fk_uo_user_id"
                     references="users(id)"
                     deleteCascade="true"/>
      </column>
      <column name="organisation_defra_id" type="VARCHAR(255)">
        <constraints primaryKey="true" nullable="false"
                     foreignKeyName="fk_uo_organisation_defra_id"
                     references="organisations(defra_id)"
                     deleteCascade="true"/>
      </column>
      <column name="relationship_type" type="VARCHAR(50)"/>
    </createTable>
    <sql>
      ALTER TABLE user_organisations
      ADD CONSTRAINT ck_uo_relationship_type CHECK (relationship_type IN ('Employee', 'Agent'));
    </sql>
    <rollback>
      <dropTable tableName="user_organisations"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
