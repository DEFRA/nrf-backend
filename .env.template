NOTIFY_API_KEY=

# Service-to-service API key required on the x-api-key header for non-public
# routes. Required in production; may be empty in dev/test (the auth scheme
# fails closed at request time when unset).
BACKEND_API_KEY=

# Service-to-service API key sent on outbound calls to the impact-assessor.
# Required in production; may be empty in dev/test.
IMPACT_ASSESSOR_API_KEY=

# When true this will generate and display the Swagger Open API documentation page at the route /docs
# We only tend to use this when developing locally.
USE_SWAGGER=false
