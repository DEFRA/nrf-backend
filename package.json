{
  "name": "nrf-backend",
  "version": "0.0.0",
  "description": "nrf-backend",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "cross-env-shell GIT_HASH=$(git rev-parse HEAD) NODE_ENV=development USE_SWAGGER=true npm run server:watch",
    "dev:debug": "cross-env-shell GIT_HASH=$(git rev-parse HEAD) NODE_ENV=development USE_SWAGGER=true npm run server:debug",
    "compose:dev": "cross-env-shell GIT_HASH=$(git rev-parse HEAD) docker compose up --build --watch",
    "docker:dev": "NODE_ENV=development USE_SWAGGER=true npm run server:watch",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run format:check && npm run lint && npm test",
    "git:pre-push-hook": "npm audit --audit-level=high",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "postinstall": "npm run setup:husky",
    "security-audit": "npm audit --audit-level=moderate",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/client-sns": "^3.1088.0",
    "@aws-sdk/credential-providers": "^3.1088.0",
    "@aws-sdk/rds-signer": "^3.1088.0",
    "@defra/cdp-auditing": "^0.6.1",
    "@defra/hapi-secure-context": "^0.4.0",
    "@defra/hapi-tracing": "^1.30.0",
    "@defra/nrf-library": "github:DEFRA/nrf-library#v1.6.0",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.9",
    "@hapi/inert": "^7.1.2",
    "aws-embedded-metrics": "^4.2.1",
    "aws4": "^1.13.2",
    "convict": "^6.2.5",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^17.4.2",
    "global-agent": "^3.0.0",
    "hapi-pino": "^13.0.0",
    "hapi-pulse": "^4.0.0",
    "hpagent": "^1.2.0",
    "https-proxy-agent": "^9.1.0",
    "joi": "^18.2.3",
    "node-fetch": "^3.3.2",
    "notifications-node-client": "^8.4.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-dist": "^5.32.8",
    "undici": "^8.7.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-no-secrets": "^2.3.3",
    "husky": "^9.1.7",
    "neostandard": "^0.13.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5",
    "vitest": "^4.1.10",
    "vitest-fetch-mock": "^0.4.5",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "joi": "$joi"
  }
}
